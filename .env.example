# Copy to .env and fill in. See README for GCP setup.

# --- Vertex AI (required) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Razorpay (optional: only needed for /create-payment-link) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
